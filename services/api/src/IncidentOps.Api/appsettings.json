{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IncidentOps": ""
  },
  "Database": {
    "ApplyMigrations": false,
    "Seed": false
  },
  "ServiceBus": {
    "FullyQualifiedNamespace": "",
    "ConnectionString": "",
    "TopicName": "incident-events"
  },
  "Azure": {
    "SignalR": {
      "ConnectionString": ""
    }
  },
  "Security": {
    "EscalationApiKey": ""
  },
  "Auth": {
    "SigningKey": "",
    "DemoUsername": "demo",
    "DemoPassword": "",
    "TokenLifetime": "08:00:00"
  },
  "Sla": {
    "TimeScale": 1.0
  },
  "Cors": {
    "AllowedOrigins": [
      "https://incidents.marceloroman.com.br",
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "WritePermitLimit": 30,
    "TokenPermitLimit": 5,
    "WindowSeconds": 60
  },
  "Outbox": {
    "PollingIntervalMilliseconds": 1000,
    "BatchSize": 50,
    "MaxAttempts": 20,
    "MaxRetryDelaySeconds": 60
  },
  "Observability": {
    "GaugeRefreshSeconds": 30
  },
  "DemoTraffic": {
    "Enabled": false,
    "IntervalSeconds": 45,
    "TargetOpenIncidents": 4
  },
  "Chaos": {
    "Enabled": false
  }
}
