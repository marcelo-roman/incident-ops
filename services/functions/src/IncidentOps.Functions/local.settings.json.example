{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "ServiceBusConnection": "Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;",
    "IncidentEventsTopic": "incident-events",
    "SlaSchedulerSubscription": "sla-scheduler",
    "NotifierSubscription": "notifier",
    "SlaChecksQueue": "sla-checks",
    "IncidentsApi__BaseUrl": "http://localhost:5080/",
    "IncidentsApi__ApiKey": "local-development-key",
    "Notifications__LogicAppUrl": "http://localhost:8099/notify-oncall",
    "Web__BaseUrl": "http://localhost:8080/"
  }
}
